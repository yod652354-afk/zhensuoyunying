# ===== ClinicOS / RevOS 环境配置示例 =====
# 复制为 .env 后按需修改

# --- 数据库 ---
# 本地开发（零配置）：
# DATABASE_URL=sqlite:///./clinicos.db
# 你的数据服务器（PostgreSQL 示例）：
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/clinicos
DATABASE_URL=sqlite:///./clinicos.db

# --- 服务 ---
APP_NAME=RevOS
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- 服务端到服务端认证 ---
# 逗号分隔的 API Key 列表；调用方通过 X-API-Key 头携带
API_KEYS=dev-key-change-me
# API Key → organization_id 映射（JSON）。生产环境必填：
# API_KEY_ORG_MAP={"prod-key-1":"org_xxx","prod-key-2":"org_yyy"}

# --- Webhook ---
# Webhook 签名密钥（HMAC-SHA256），正式环境务必更换
WEBHOOK_SECRET=dev-webhook-secret-change-me
# Webhook 投递基础 URL（前端用于配置订阅时自动填充）
WEBHOOK_BASE_URL=http://127.0.0.1:8001
# Webhook 投递重试：指数退避基数（秒）与最大次数
WEBHOOK_RETRY_BASE_SECONDS=5
WEBHOOK_MAX_RETRIES=5
# 投递模式：log（仅记录，不真正外发，开发默认）| http（真实投递）
WEBHOOK_DELIVERY_MODE=log

# --- 种子数据 ---
SEED_DEMO_DATA=true
# --- 每日自动任务调度 ---
TASK_SCHEDULE_ENABLED=true
TASK_SCHEDULE_HOUR=9
TASK_SCHEDULE_MINUTE=0
TASK_DAILY_RECOVERY_LIMIT=30

# ===== RevOS（ClinicOS → RevOS 兼容升级） =====
# --- AI 内容生成 Provider：mock（默认，零成本）| http（真实供应商经环境变量注入） ---
REVOS_TEXT_PROVIDER=mock
REVOS_IMAGE_PROVIDER=mock
REVOS_TEXT_PROVIDER_URL=
REVOS_TEXT_PROVIDER_API_KEY=
REVOS_TEXT_PROVIDER_MODEL=
REVOS_IMAGE_PROVIDER_URL=
REVOS_IMAGE_PROVIDER_API_KEY=
REVOS_IMAGE_PROVIDER_MODEL=
REVOS_LLM_TIMEOUT_SECONDS=30
REVOS_LLM_MAX_RETRIES=2

# --- 企微 Gateway：simulator（默认）| http（真实凭证） ---
REVOS_WECOM_MODE=simulator
REVOS_WECOM_CORPID=
REVOS_WECOM_SECRET=
REVOS_WECOM_API_BASE=https://qyapi.weixin.qq.com/cgi-bin
REVOS_WECOM_AGENT_ID=

# --- 小程序 wx.login ---
REVOS_WX_APPID=
REVOS_WX_SECRET=
REVOS_MP_TICKET_TTL_SECONDS=3600

# --- 运营参数 ---
REVOS_DORMANT_DAYS=60            # 沉睡召回：无到店/消费天数阈值
REVOS_TOUCH_FREQUENCY_DAYS=14    # 主动营销触达频控
REVOS_OPPORTUNITY_TTL_DAYS=30    # 机会有效期
REVOS_ARBITRATION_CYCLE_DAYS=7   # 仲裁周期（同一周期只选一个主要外部计划）
REVOS_STAFF_DAILY_TOUCH_LIMIT=20 # 员工当日触达上限
REVOS_STORE_DAILY_TOUCH_LIMIT=200# 门店当日触达上限
REVOS_MIN_EXPERIMENT_SAMPLE=30   # 实验最低样本（不足只给方向性结论）
REVOS_OBSERVATION_WINDOW_DAYS=30 # 归因观察窗口
